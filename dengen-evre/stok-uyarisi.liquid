{%- comment -%}
  DENGEN · Gerçek stok uyarısı
  Shopify'daki gerçek stok sayısını okur. Stok "esik" değerinin altına düşünce
  "Stokta son X şişe kaldı" yazar; stok bol ya da takip kapalıysa hiçbir şey göstermez.
  Çalışması için: Ürünler > Dengen Evre > Envanter > "Miktarı takip et" açık,
  "Stokta yokken satışa devam et" kapalı olmalı.
  Kullanım: Ürün sayfası > Bölüm ekle > "Özel Liquid" > yapıştır. Uyarı kendini
  "Stokta · Hemen kargoya hazır" satırının altına taşır.
{%- endcomment -%}
{%- liquid
  assign esik = 25
  assign v = product.selected_or_first_available_variant
  assign adet = v.inventory_quantity | default: 0
  assign doluluk = adet | times: 100 | divided_by: esik
  if doluluk < 8
    assign doluluk = 8
  endif
-%}
{%- if v.inventory_management == 'shopify' and v.inventory_policy == 'deny' and adet > 0 and adet <= esik -%}
  <div class="dgn-stk" data-dgn-stk role="status">
    <p class="dgn-stk__t"><span class="dgn-stk__dot" aria-hidden="true"></span><span>Stoklarımız tükeniyor: son <strong>{{ adet }} şişe</strong> kaldı</span></p>
    <span class="dgn-stk__bar" aria-hidden="true"><i style="width:{{ doluluk }}%"></i></span>
  </div>

  <style>
    .dgn-stk{max-width:520px;margin:10px 0 0;padding:0}
    .dgn-stk__t{display:flex;align-items:center;gap:8px;margin:0;font-size:14px;font-weight:600;line-height:1.3;color:#9A3412}
    .dgn-stk__t strong{font-weight:800}
    .dgn-stk__dot{position:relative;flex:none;width:8px;height:8px;border-radius:50%;background:#EA580C}
    .dgn-stk__dot::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:2px solid #EA580C;opacity:0;animation:dgn-stk-p 1.8s ease-out infinite}
    .dgn-stk__bar{display:block;height:6px;margin-top:8px;border-radius:999px;background:#FDE7D6;overflow:hidden}
    .dgn-stk__bar i{display:block;height:100%;border-radius:inherit;background:#EA580C}
    @keyframes dgn-stk-p{0%{transform:scale(.6);opacity:.7}100%{transform:scale(1.6);opacity:0}}
    @media (prefers-reduced-motion:reduce){.dgn-stk__dot::after{animation:none}}
  </style>

  <script>
    (function () {
      var el = document.querySelector('[data-dgn-stk]');
      var hedef = document.querySelector('.pu-st');
      if (el && hedef && !el.getAttribute('data-ready')) {
        el.setAttribute('data-ready', '1');
        hedef.insertAdjacentElement('afterend', el);
      }
    })();
  </script>
{%- endif -%}
