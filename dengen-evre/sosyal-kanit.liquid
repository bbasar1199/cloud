{%- comment -%}
  DENGEN · "Son 7 günde X sipariş" rozeti
  Aşağıdaki "son_7_gun_siparis" sayısını Shopify > Analizler > Siparişler (son 7 gün)
  ekranındaki gerçek sayıyla değiştir. Haftada bir güncelle. 0 yazarsan rozet gizlenir.
  Kullanım: Ürün sayfası > Bölüm ekle > "Özel Liquid" > yapıştır. Rozet kendini
  "Dengen Evre" başlığının hemen altına taşır.
{%- endcomment -%}
{%- liquid
  assign son_7_gun_siparis = 0
-%}
{%- if son_7_gun_siparis > 0 -%}
  <div class="dgn-sk" data-dgn-sk>
    <span class="dgn-sk__ic" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
    </span>
    <p class="dgn-sk__t">Son 7 günde <strong>{{ son_7_gun_siparis }} sipariş</strong> verildi</p>
  </div>

  <style>
    .dgn-sk{display:flex;align-items:center;gap:8px;width:fit-content;max-width:100%;margin:8px 0 2px;padding:5px 12px 5px 5px;border-radius:999px;background:var(--nane,#E8FFF6);color:var(--g,#1C6047)}
    .dgn-sk__ic{flex:none;width:24px;height:24px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center}
    .dgn-sk__ic svg{width:14px;height:14px;fill:currentColor;stroke:none}
    .dgn-sk__t{margin:0;font-size:13px;font-weight:600;line-height:1.3}
    .dgn-sk__t strong{font-weight:800}
  </style>

  <script>
    (function () {
      var el = document.querySelector('[data-dgn-sk]:not([data-ready])');
      if (!el) return;
      // Tema düzenleyici bölümü yeniden yüklediğinde eski kopyayı kaldır.
      [].forEach.call(document.querySelectorAll('[data-dgn-sk][data-ready]'), function (eski) { eski.remove(); });
      el.setAttribute('data-ready', '1');
      var baslik = document.querySelector('.pu-ad');
      var stok = document.querySelector('.pu-st');
      if (baslik) baslik.insertAdjacentElement('afterend', el);
      else if (stok) stok.insertAdjacentElement('beforebegin', el);
    })();
  </script>
{%- endif -%}
