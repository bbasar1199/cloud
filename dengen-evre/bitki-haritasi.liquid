          <button type="button" class="dgn-hm__node dgn-hm__node--up is-on" style="--i:0" aria-pressed="true"><span class="dgn-hm__dot"><svg><use href="#dgn-hm-karayilan"/></svg></span><span class="dgn-hm__lbl">Karayılan otu</span></button>
          <button type="button" class="dgn-hm__node dgn-hm__node--up" style="--i:1" aria-pressed="false"><span class="dgn-hm__dot"><svg><use href="#dgn-hm-adacayi"/></svg></span><span class="dgn-hm__lbl">Adaçayı</span></button>
          <button type="button" class="dgn-hm__node" style="--i:2" aria-pressed="false"><span class="dgn-hm__dot"><svg><use href="#dgn-hm-melisa"/></svg></span><span class="dgn-hm__lbl">Melisa</span></button>
